# =============================================
# CHARACTER CAREER BLUEPRINT — ENVIRONMENT
# Copy to .env and fill in values.
# Never commit .env to version control.
# =============================================

# ── APPLICATION ───────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── DATABASE ──────────────────────────────────
POSTGRES_PASSWORD=devpassword_change_me
# DATABASE_URL is auto-constructed in docker-compose.yml
# Override here only when running outside Docker:
# DATABASE_URL=postgresql+asyncpg://ccblueprint:devpassword_change_me@localhost:5432/ccblueprint

# ── REDIS ─────────────────────────────────────
# Auto-set in docker-compose.yml. Override here only for external Redis:
# REDIS_URL=redis://localhost:6379/0

# Production only
# REDIS_PASSWORD=change_in_production

# ── SECURITY ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REPORT_TOKEN_SECRET=replace-with-random-64-char-hex
ADMIN_SECRET_KEY=replace-with-another-random-64-char-hex

# ── AI PROVIDERS ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# ── EMAIL (RESEND) ────────────────────────────
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── FRONTEND ──────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── EXTERNAL LINKS (configurable) ─────────────
MBTI_EXTERNAL_URL=https://www.16personalities.com/
HD_EXTERNAL_URL=https://www.jovianarchive.com/get_your_chart
NEXT_PUBLIC_MBTI_URL=https://www.16personalities.com/
NEXT_PUBLIC_HD_URL=https://www.jovianarchive.com/get_your_chart

# ── SEED DATA ─────────────────────────────────────────────────────────────────
ADMIN_DEFAULT_EMAIL=admin@ccblueprint.local
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
